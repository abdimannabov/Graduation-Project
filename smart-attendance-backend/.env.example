# Copy this file to .env and fill the values
# Base URL of your Moodle site (no trailing slash required or allowed) e.g.
MOODLE_URL=http://localhost/moodle
# A valid web service token generated in your Moodle site for a user with the required capabilities
MOODLE_TOKEN=your_moodle_token_here
# Port for this backend
PORT=5000

# Optional local dev settings
# Set to true if your local Moodle uses a self-signed certificate (development only)
MOODLE_ALLOW_INSECURE_TLS=true

# QR token settings
QR_JWT_SECRET=your_long_random_secret_here
QR_TTL_SECONDS=30

# Auth mode: 'dev' will accept x-user-email header; 'none' disables auth
AUTH_MODE=dev

# Teacher secret for generating QR in dev mode (set this to a random secret and provide it as x-teacher-secret header)
TEACHER_SECRET=change_this_to_a_secret

# Moodle user ID that represents the agent marking attendance (optional)
# If not provided, calls will use the token owner's permissions where applicable.
MOODLE_TAKENBYID=
